MONGODB_URI=mongodb://mongo:27017/websterwork
PORT=5000
NODE_ENV=production
JWT_ACCESS_SECRET=super_long_random_access_secret_here
JWT_REFRESH_SECRET=super_long_random_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CSRF_COOKIE_NAME=XSRF-TOKEN
REFRESH_COOKIE_NAME=COOKIE
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BCRYPT_SALT_ROUNDS=12
CSP_DIRECTIVES="default-src 'self'; script-src 'self'; object-src 'none'"
