FROM node:22-alpine

# Use IPv4 first for DNS issues
ENV NODE_OPTIONS=--dns-result-order=ipv4first

# Install build tools for npm packages that require compilation
RUN apk add --no-cache python3 make g++ bash

# Create non-root user
RUN addgroup -S app && adduser -S app -G app

WORKDIR /app

# Copy package.json first for caching
COPY package*.json ./

# Install npm packages as root (needed for some packages on Alpine)
RUN npm config set registry https://registry.npmjs.org/ && \
    npm install --no-audit --no-fund --fetch-retries=5 \
      --fetch-retry-factor=2 --fetch-retry-mintimeout=20000 \
      --fetch-retry-maxtimeout=120000

# Copy the rest of the app
COPY . .

# Build frontend
RUN npm run build

# Switch to non-root user
USER app

EXPOSE 3000

CMD ["npm", "start"]
